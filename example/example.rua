# Rua 简易版测试程序

变量 a = 10
变量 b = 20
喵叫("a + b = ", a + b)

#* 多行注释
   测试
*#

如果 a + b == 30 那么 {
    喵叫("结果正确")
} 否则 {
    喵叫("结果错误")
}

变量 i = 0
当 i < 3 那么 {
    喵叫("循环: ", i)
    i = i + 1
}

喵 fib(n) {
    如果 n <= 1 那么 {
        返回 n
    }
    返回 fib(n - 1) + fib(n - 2)
}

喵叫("fib(10) = ", fib(10))

数组 示例[3] = {7}
示例[1] = 99
喵叫("数组[0] = ", 示例[0], " 数组[1] = ", 示例[1], " 数组[2] = ", 示例[2])

喵 主函数() {
    变量 x = 1
    如果 x == 1 那么 {
        喵叫("嵌套函数执行成功")
    }
    返回 0
}

主函数()
