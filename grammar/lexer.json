{
  "meta": {
    "language": "Rua",
    "version": "0.2.0",
    "note": "词法层描述。所有 token 全量列出；used 标记该 token 是否被当前 parser 消费。used=false 表示词法已识别但语法未使用（留给语法糖）。",
    "encoding": "源码按 UTF-8 读取，词法阶段转为 UTF-32 处理",
    "newline": "换行符是一个独立 token（类型 换行符），parser 在语句边界跳过它",
    "comment": "单行注释以 # 开头到行尾；多行注释为 #* ... *#",
    "whitespace": "空格 / 制表符 / 回车不产生 token，直接跳过",
    "identifier": "以 a-z A-Z 0-9 _ 或中文字符开头，由连续的可标识字符组成"
  },
  "keywords": {
    "函数关键字": { "text": "喵", "used": true, "note": "函数定义" },
    "如果关键字": { "text": "如果", "used": true, "note": "条件分支" },
    "那么关键字": { "text": "那么", "used": true, "note": "分支体前导，必填" },
    "否则关键字": { "text": "否则", "used": true, "note": "else 分支，可选" },
    "或者关键字": { "text": "或者", "used": false },
    "返回关键字": { "text": "返回", "used": true, "note": "return 语句" },
    "当关键字": { "text": "当", "used": true, "note": "while 循环" },
    "变量关键字": { "text": "变量", "used": true, "note": "变量声明" },
    "数组关键字": { "text": "数组", "used": true, "note": "数组声明" },
    "喵叫关键字": { "text": "喵叫", "used": true, "note": "内置打印函数" },
    "运行关键字": { "text": "运行", "used": true, "note": "内置调用/入口关键字（REPL 中亦为执行命令）" }
  },
  "symbols": {
    "标识符": { "text": "<identifier>", "used": true },
    "数字": { "text": "<number>", "used": true, "note": "十进制整数" },
    "字符串": { "text": "<string>", "used": true, "note": "支持 ' ' \" \" ‘ ’ “ ” 四种引号，\\ 转义" },
    "左括号": { "text": "(", "used": true },
    "右括号": { "text": ")", "used": true },
    "左中括号": { "text": "[", "used": true },
    "右中括号": { "text": "]", "used": true },
    "左花括号": { "text": "{", "used": true },
    "右花括号": { "text": "}", "used": true },
    "逗号": { "text": ",", "used": true },
    "分号": { "text": ";", "used": false },
    "等号": { "text": "=", "used": true, "note": "赋值 / 声明初始化" },
    "加号": { "text": "+", "used": true },
    "减号": { "text": "-", "used": true },
    "乘号": { "text": "*", "used": true },
    "除号": { "text": "/", "used": true },
    "等于": { "text": "==", "used": true },
    "不等于": { "text": "!=", "used": true },
    "大于": { "text": ">", "used": true },
    "小于": { "text": "<", "used": true },
    "大于等于": { "text": ">=", "used": true },
    "小于等于": { "text": "<=", "used": true },
    "模": { "text": "%", "used": true },
    "乘方": { "text": "**", "used": false, "note": "词法已识别（含 **=），语法未支持" },
    "整除": { "text": "//", "used": false, "note": "词法已识别（含 //=），语法未支持" },
    "加等于": { "text": "+=", "used": false, "note": "复合赋值，语法未支持" },
    "减等于": { "text": "-=", "used": false },
    "乘等于": { "text": "*=", "used": false },
    "除等于": { "text": "/=", "used": false },
    "乘方等于": { "text": "**=", "used": false },
    "模等于": { "text": "%=", "used": false },
    "整除等于": { "text": "//=", "used": false },
    "换行符": { "text": "<newline>", "used": true, "note": "parser 在语句边界跳过" },
    "结束": { "text": "<eof>", "used": true, "note": "输入结束标记" }
  }
}
